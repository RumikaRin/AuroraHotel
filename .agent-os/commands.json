{
  "profile": "next-monolith",
  "packageManager": "npm",
  "commands": {
    "dev": "npm run dev",
    "build": "npm run build",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm run test",
    "e2e": "npm run e2e"
  },
  "gateOrder": [
    "lint",
    "typecheck",
    "test",
    "build",
    "e2e"
  ]
}
