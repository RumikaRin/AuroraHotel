# ============================================================
# Database (Neon PostgreSQL)
# ============================================================
# DATABASE_ENVIRONMENT choices: development | test | preview | production | restore-test
DATABASE_ENVIRONMENT="development"

# Pooled Neon connection used by the running Next.js application
DATABASE_URL="postgresql://aurora_development_app:example-secret-password@ep-dev-pooler.us-east-2.aws.neon.tech/aurora_development?sslmode=require"

# Direct Neon connection used ONLY for Prisma CLI migrations, seed, and restore drills
DIRECT_URL="postgresql://aurora_development_app:example-secret-password@ep-dev.us-east-2.aws.neon.tech/aurora_development?sslmode=require"

# Test environment connection pair (used by test runner)
TEST_DATABASE_URL="postgresql://aurora_test_runner:example-secret-password@ep-test-pooler.us-east-2.aws.neon.tech/aurora_test?sslmode=require"
TEST_DIRECT_URL="postgresql://aurora_test_runner:example-secret-password@ep-test.us-east-2.aws.neon.tech/aurora_test?sslmode=require"
ALLOW_REMOTE_TEST_RESET="aurora_test"

# ============================================================
# Auth (Auth.js / NextAuth v5)
# ============================================================
AUTH_SECRET="dev-only-secret-change-me-please-0123456789"
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"

# ============================================================
# Hotel Business Config
# ============================================================
HOTEL_TIME_ZONE="Asia/Ho_Chi_Minh"

# ============================================================
# Storage & Media (Vercel Blob)
# ============================================================
MEDIA_PROVIDER="vercel-blob"
BLOB_PRIVATE_READ_WRITE_TOKEN="vercel_blob_rw_example_private_token_32chars"
BLOB_PUBLIC_READ_WRITE_TOKEN="vercel_blob_rw_example_public_token_32chars"
NEXT_PUBLIC_BLOB_UPLOAD_ORIGIN="https://example-private.private.blob.vercel-storage.com"
NEXT_PUBLIC_MEDIA_ORIGIN="https://example-public.public.blob.vercel-storage.com"

# ============================================================
# Internal Jobs & Services
# ============================================================
CRON_SECRET="example-cron-secret-at-least-32-characters-long"
MOCK_PAYMENT_SECRET="example-mock-payment-secret-32-chars-long"
JOB_SECRET="example-job-secret-at-least-32-characters-long"
EMAIL_PROVIDER="preview"
PAYMENT_PROVIDER="mock"
