# ============================================================
# Database
# ============================================================
# Mac dinh dung SQLite de "npm install" khong can database ngoai.
DATABASE_URL="file:./dev.db"

# Chuyen sang Postgres khi len production:
# 1) Doi provider trong prisma/schema.prisma tu "sqlite" sang "postgresql"
#    (xem comment ngay trong file schema).
# 2) Dung chuoi ket noi ben duoi va chay lai: npx prisma migrate dev
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starter?schema=public"

# ============================================================
# Auth (NextAuth v5)
# ============================================================
# Sinh secret moi bang: npx auth secret  (hoac: openssl rand -base64 32)
AUTH_SECRET="dev-only-secret-change-me-please-0123456789"
# Bat buoc khi chay sau reverse proxy / localhost khong phai https
AUTH_TRUST_HOST=true

# ============================================================
# Rate limiting (Upstash Redis REST) - tuy chon
# ============================================================
# Neu bo trong: dev dung in-memory limiter; production se FAIL-CLOSED
# (tra 503) cho cac endpoint nhay cam vi in-memory limiter khong an toan
# khi chay nhieu instance. Xem src/lib/rate-limiter.ts.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
NEXTAUTH_URL=""
